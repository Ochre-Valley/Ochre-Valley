/datum/patron/old_god/ortho
	name = "Otavan Puritanism"
	domain = "Otava"
	desc = "''Otava's interpretation of Psydon, one of the most puritanical expressions of the Old God. \
	<br>They maintain that Psydon is the only true God, and that the Ten are but His saintly servants. And while these Saints are examples to follow, they do not deserve the same reverence to God Himself. \
	<br>Known for their strict adherence to Purity, they are at odds with other Genesists, and beloathed by Grenzelhoft and Tennites in general. \
	<br>Nevertheless, as largest faith of Psydon, they are most influental on smaller sects and regional interpretations."
	worshippers = "Otavan Natives, Inquisitorial Wards, Redeemed Criminals"
	confess_lines = list(
		"THERE IS ONLY ONE TRUE GOD!",
		"PSYDON YET LYVES! PSYDON YET ENDURES!",
		"REBUKE THE HEATHEN, SUNDER THE MONSTER!",
		"MY GOD - WITH EVERY BROKEN BONE, I SWORE I LYVED!",
		"EVEN NOW, THERE IS STILL HOPE FOR MAN! AVE PSYDONIA!",
		"YOU WILL NOT BREAK ME, BROTHER, I AM PURE!",
		"FOUL SCHISMATIC, I WILL NOT BEND TO YOUR FOLLY!",
	)

	titles = list(
		"Psydon",
		"God", // people call him this for. some reason. he has a name, y'all
		"Architect",
		"Allfather",
		"Creator",
		"Father",
	)
