// Voidastra Lirvas firestaff kit and appearances
/obj/item/enchantingkit/voidastra_staff
	name = "'Ornate Lirvas Firestaff' morphing elixir"
	desc = "A small container of special morphing dust, perfect to make a specific item. It can be used to alter the appearance of casting staffs."
	target_items = list(
		/obj/item/rogueweapon/woodstaff/implement/greater/blacksteel		= /obj/item/rogueweapon/woodstaff/implement/greater/blacksteel/voidastra,
		/obj/item/rogueweapon/woodstaff/implement/grand/blacksteel			= /obj/item/rogueweapon/woodstaff/implement/grand/blacksteel/voidastra,
		/obj/item/rogueweapon/woodstaff/implement/grand/magos				= /obj/item/rogueweapon/woodstaff/implement/grand/magos/voidastra,
		/obj/item/rogueweapon/woodstaff/implement/grand						= /obj/item/rogueweapon/woodstaff/implement/grand/voidastra,
		/obj/item/rogueweapon/woodstaff/implement/greater/quartz			= /obj/item/rogueweapon/woodstaff/implement/greater/quartz/voidastra,
		/obj/item/rogueweapon/woodstaff/implement/amethyst					= /obj/item/rogueweapon/woodstaff/implement/amethyst/voidastra
	)
	result_item = null

/obj/item/rogueweapon/woodstaff/implement/greater/blacksteel/voidastra
	name = "ornate Lirvas firestaff"
	desc = "A unique staff, ordained from rare, valuable metals and gems. Fire spills from the top, where a golden chunk of molten metal is constantly refined by the flame. With this gaudy design, one can assume that something of this appearance is heavily influenced by Lirvas culture."
	icon_state = "voidastra_firestaff"
	icon = 'modular_ochrevalley/icons/obj/items/donor_weapons_64.dmi'

